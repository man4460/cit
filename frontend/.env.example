# API backend — ค่าเริ่มต้นพอร์ต 4000
VITE_API_URL=http://localhost:4000

# ถ้าเปิดเว็บที่ http://localhost:5173 แต่ต้องการให้ QR ครุภัณฑ์ชี้ไปที่มือถือใน LAN:
# VITE_PUBLIC_ORIGIN=http://192.168.1.100:5173
#
# Cloudflare / production:
# VITE_API_URL=
# VITE_PUBLIC_ORIGIN=https://allforone.ma-well.com
# (ว่าง = เรียก /api แบบ path เดียวกับหน้าเว็บ — ต้องมี reverse proxy)
