// Cash-in-Transit & Mission Management
// MySQL: ตั้ง DATABASE_URL ใน .env แล้วรัน npx prisma db push
// ตัวอย่าง: mysql://USER:PASSWORD@localhost:3306/cit_mission

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- Personnel & masters ---

model PersonnelCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  personnel Personnel[]
}

model OrganizationUnitType {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  personnel Personnel[]
}

model Personnel {
  id       String  @id @default(uuid())
  photoUrl String?
  fullName String
  idNumber String  @unique
  rank     String?
  position String?
  phone    String?

  personnelCategoryId String?
  personnelCategory   PersonnelCategory? @relation(fields: [personnelCategoryId], references: [id], onDelete: SetNull)

  organizationUnitTypeId String?
  organizationUnitType   OrganizationUnitType? @relation(fields: [organizationUnitTypeId], references: [id], onDelete: SetNull)

  insuranceCompany      String?
  insurancePolicyNumber String?
  insuranceExpiry       DateTime?
  insuranceNotes        String?   @db.Text

  remarks   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beneficiaries           PersonnelBeneficiary[]
  missionAssignments      MissionPersonnel[]
  assetsAudited           Asset[]                  @relation("AssetAuditor")
  inspections             AssetInspection[]
  armorMonthlyInspections ArmorMonthlyInspection[]
  trainingEnrollments     TrainingEnrollment[]
}

// --- ทะเบียนการอบรม ---

enum TrainingResultStatus {
  PASSED
  FAILED
}

model TrainingCourse {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments TrainingEnrollment[]
}

model TrainingEnrollment {
  id                String               @id @default(uuid())
  personnelId       String
  personnel         Personnel            @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  trainingCourseId  String
  trainingCourse    TrainingCourse       @relation(fields: [trainingCourseId], references: [id], onDelete: Restrict)
  trainingStartDate DateTime
  trainingEndDate   DateTime
  status            TrainingResultStatus @default(PASSED)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model PersonnelBeneficiary {
  id           String    @id @default(uuid())
  personnelId  String
  personnel    Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  fullName     String
  relationship String?
  phone        String?
  idNumber     String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// --- Vehicles ---

enum VehicleAttachmentKind {
  PHOTO
  DOCUMENT
}

/// ผลตรวจรายข้อ — ปกติ / ผิดปกติ (หรือไม่ปกติ ใช้ค่าเดียวกัน)
enum VehicleWeeklyCheckResult {
  NORMAL
  ABNORMAL
}

model VehicleType {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]
}

model WorkCategoryGroup {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]
}

model VehicleStatus {
  id                    String   @id @default(uuid())
  name                  String   @unique
  sortOrder             Int      @default(0)
  /// true = ไม่นับในยอดตรวจ/ดูแล (จำหน่าย ส่งคืน ฯลฯ)
  excludesFromFleetCare Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  vehicles Vehicle[]
}

model Vehicle {
  id             String  @id @default(uuid())
  /// สตริงแสดงผลรวม (ยี่ห้อ + รุ่น) — sync จาก API
  brandModel     String
  licensePlate   String  @unique
  /// เลขรหัสครุภัณฑ์ (ไม่ซ้ำถ้ากรอก)
  assetCode      String? @unique
  chassisNumber  String?
  engineNumber   String?
  color          String?
  brand          String  @default("")
  model          String  @default("")
  currentMileage Decimal @default(0)

  vehicleTypeId String?
  vehicleType   VehicleType? @relation(fields: [vehicleTypeId], references: [id], onDelete: SetNull)

  workCategoryGroupId String?
  workCategoryGroup   WorkCategoryGroup? @relation(fields: [workCategoryGroupId], references: [id], onDelete: SetNull)

  vehicleStatusId String?
  vehicleStatus   VehicleStatus? @relation(fields: [vehicleStatusId], references: [id], onDelete: SetNull)

  /// หมายเหตุ / ข้อมูลเสริมจากทะเบียน (เช่น ศูนย์ต้นทุน ประเภทน้ำมัน วันสำรวจ)
  notes String? @db.Text

  /// วันจัดซื้อ (ใช้คำนวณอายุรถในหน้าเว็บ)
  purchasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents         VehicleDocument[]
  maintenanceLogs   MaintenanceLog[]
  fuelLogs          FuelConsumptionLog[]
  missionVehicles   MissionVehicle[]
  weeklyInspections VehicleWeeklyInspection[]
  dispositionLogs   VehicleDispositionLog[]
}

/// จำหน่าย / ส่งคืนครุภัณฑ์ (บันทึกเมื่อเข้าสถานะที่ excludesFromFleetCare)
enum DispositionKind {
  DISPOSED
  RETURNED
}

model VehicleDispositionLog {
  id            String          @id @default(uuid())
  vehicleId     String
  vehicle       Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  kind          DispositionKind
  statusName    String
  licensePlate  String
  brandModel    String
  note          String?
  actorUserId   String?
  actorUsername String?
  recordedAt    DateTime        @default(now())
}

/// บันทึกตรวจยานพาหนะประจำสัปดาห์ (หนึ่งแถวต่อคัน ต่อวันอ้างอิงสัปดาห์)
model VehicleWeeklyInspection {
  id             String   @id @default(uuid())
  vehicleId      String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// วันอ้างอิงสัปดาห์ (เก็บเป็น UTC เที่ยงของวันที่เลือก ให้ unique ต่อคัน)
  inspectionDate DateTime

  airConditioning VehicleWeeklyCheckResult?
  engineOperation VehicleWeeklyCheckResult?
  tireCondition   VehicleWeeklyCheckResult?
  cctvAnalog      VehicleWeeklyCheckResult?
  cctvThinkware   VehicleWeeklyCheckResult?
  engineStart5Min VehicleWeeklyCheckResult?

  remarks       String? @db.Text
  /// ชื่อผู้ตรวจ (ข้อความ)
  inspectorName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleId, inspectionDate])
}

model VehicleDocument {
  id           String                @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fileUrl      String
  mimeType     String?
  originalName String?
  kind         VehicleAttachmentKind @default(DOCUMENT)
  sortOrder    Int                   @default(0)
  createdAt    DateTime              @default(now())
}

model MaintenanceLog {
  id        String   @id @default(uuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date      DateTime
  detail    String   @db.Text
  cost      Decimal
  createdAt DateTime @default(now())
}

model FuelConsumptionLog {
  id        String   @id @default(uuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date      DateTime
  liters    Decimal?
  cost      Decimal?
  odometer  Decimal?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
}

// --- คลังเอกสาร ---

model DocumentType {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents LibraryDocument[]
}

model LibraryDocument {
  id             String        @id @default(uuid())
  title          String
  details        String        @db.Text
  /**
   * ข้อความถอดจากไฟล์ (PDF / รูป OCR / ข้อความล้วน)
   */
  extractedText  String?       @db.LongText
  documentTypeId String?
  documentType   DocumentType? @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  fileUrl        String?
  mimeType       String?
  originalName   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  osAcceptanceLinks OsAcceptanceDocument[]
  osContractLinks   OsContractDocument[]
}

// --- อัคคีภัย / ถังดับเพลิง ---

model FireExtinguisher {
  id             String    @id @default(uuid())
  code           String    @unique
  location       String
  kind           String
  sizeLabel      String
  manufacturedAt DateTime?
  status         String    @default("ปกติ")
  guardTeam      String?
  notes          String?   @db.Text
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/**
 * ตู้สายดับเพลิง / โฮสต์อัคคีภัย (จาก FireHost.csv)
 */
model FireHost {
  id        String   @id @default(uuid())
  code      String   @unique
  detail    String   @db.Text
  location  String
  guardTeam String?
  track     Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * เสื้อเกราะกันกระสุน (จาก bulletproof_vest.csv)
 */
model BulletproofVest {
  id              String    @id @default(uuid())
  code            String    @unique
  description     String    @db.Text
  level           String    @default("")
  team            String?
  capturedAt      DateTime?
  costCenter      String?
  registerNo      String?
  permitBeginsAt  DateTime?
  permitExpiresAt DateTime?
  notes           String?   @db.Text
  docUrl          String?   @db.Text
  mailUrl         String?   @db.Text
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/**
 * อาวุธปืน (จาก Gun.csv)
 */
model Firearm {
  id           String    @id @default(uuid())
  code         String    @unique
  costCenter   String?
  brand        String    @db.VarChar(512)
  serial       String?
  registerNo   String?
  registerCard String?
  purchasedAt  DateTime?
  detail       String?   @db.Text
  team         String?
  docUrl       String?   @db.Text
  photoUrl     String?   @db.Text
  status       String    @default("")
  checked      String?
  fixNote      String?   @db.Text
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/**
 * กระสุนปืน — สต๊อกรายล็อตตามวันจัดซื้อ (อายุ 5 ปี)
 */
model Ammunition {
  id           String     @id @default(uuid())
  sourceKey    String     @unique
  code         String
  kind         String
  purchasedAt  DateTime?
  team         String?
  detail       String?    @db.Text
  receivedQty  Int        @default(0)
  remainingQty Int        @default(0)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  moves        AmmoMove[]
}

enum AmmoMoveKind {
  IN
  OUT
}

model AmmoMove {
  id             String       @id @default(uuid())
  ammunitionId   String
  ammunition     Ammunition   @relation(fields: [ammunitionId], references: [id], onDelete: Cascade)
  kind           AmmoMoveKind
  quantity       Int
  movedAt        DateTime
  withdrawnBy    String?
  note           String?
  remainingAfter Int
  createdAt      DateTime     @default(now())

  @@index([ammunitionId, movedAt])
}

// --- Assets (ครุภัณฑ์) & inspections ---

enum AssetAttachmentKind {
  PHOTO
  PERMIT
}

model AssetCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[]
}

/// ประจำ (เดิม: รอบตรวจ)
model AssetRoutine {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[]
}

/// สังกัด
model AssetAffiliation {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[]
}

/// สถานะครุภัณฑ์
model AssetItemStatus {
  id                    String   @id @default(uuid())
  name                  String   @unique
  sortOrder             Int      @default(0)
  /// true = ไม่นับในยอดตรวจ/ดูแล (จำหน่าย ส่งคืน ฯลฯ)
  excludesFromFleetCare Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  assets Asset[]
}

model Asset {
  id                  String  @id @default(uuid())
  /// เลขครุภัณฑ์
  serialNumber        String  @unique
  itemName            String
  location            String
  /// เลขประจำตัวเครื่อง
  machineSerialNumber String?
  notes               String? @db.Text

  /// ศูนย์ต้นทุน (Cost center)
  costCenter  String?
  /// ยี่ห้ออุปกรณ์ (เช่น วิทยุสื่อสาร)
  deviceBrand String?
  /// รุ่นอุปกรณ์
  deviceModel String?

  /// ลำดับในทะเบียน (เช่น ทะเบียนควบคุมยุทธภัณฑ์)
  registryLineNo   Int?
  /// ระดับการป้องกัน (เช่น 2)
  armorLevel       String?
  /// แบบ (เช่น สวมทับใน)
  armorWearStyle   String?
  /// รุ่น (เช่น CONCEAL)
  armorModel       String?
  /// หมายเลขชิ้น (เช่น 001)
  armorUnitNumber  String?
  /// เลขที่หนังสืออนุญาต
  permitDocumentNo String?
  /// วันหมดอายุใบอนุญาต (แยกจากวันหมดอายุตามทะเบียนครุภัณฑ์)
  permitExpiresAt  DateTime?
  /// วันจัดซื้อ
  purchasedAt      DateTime?
  /// วันหมดอายุ (ตามทะเบียน)
  armorExpiresAt   DateTime?

  assetCategoryId String?
  assetCategory   AssetCategory? @relation(fields: [assetCategoryId], references: [id], onDelete: SetNull)

  assetRoutineId String?
  assetRoutine   AssetRoutine? @relation(fields: [assetRoutineId], references: [id], onDelete: SetNull)

  assetAffiliationId String?
  assetAffiliation   AssetAffiliation? @relation(fields: [assetAffiliationId], references: [id], onDelete: SetNull)

  assetItemStatusId String?
  assetItemStatus   AssetItemStatus? @relation(fields: [assetItemStatusId], references: [id], onDelete: SetNull)

  auditorId String?
  auditor   Personnel? @relation("AssetAuditor", fields: [auditorId], references: [id], onDelete: SetNull)

  /// Stable token encoded in QR (URL-safe lookup)
  qrToken   String   @unique @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents               AssetDocument[]
  inspections             AssetInspection[]
  dispositionLogs         AssetDispositionLog[]
  armorMonthlyInspections ArmorMonthlyInspection[]
}

model AssetDispositionLog {
  id            String          @id @default(uuid())
  assetId       String
  asset         Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind          DispositionKind
  statusName    String
  serialNumber  String
  itemName      String
  note          String?
  actorUserId   String?
  actorUsername String?
  recordedAt    DateTime        @default(now())
}

model AssetDocument {
  id           String              @id @default(uuid())
  assetId      String
  asset        Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fileUrl      String
  mimeType     String?
  originalName String?
  kind         AssetAttachmentKind @default(PHOTO)
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
}

model AssetInspection {
  id          String     @id @default(uuid())
  assetId     String
  asset       Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  personnelId String?
  personnel   Personnel? @relation(fields: [personnelId], references: [id], onDelete: SetNull)
  status      String     @default("OK")
  notes       String?    @db.Text
  inspectedAt DateTime   @default(now())
}

/// ตรวจสอบสภาพเสื้อเกราะ / ยุทธภัณฑ์ป้องกัน — บันทึกรายเดือน (เดือนละหนึ่งแถวต่อครุภัณฑ์)
model ArmorMonthlyInspection {
  id      String @id @default(uuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// ปี-เดือน เช่น 2026-04
  monthYm String

  outerShell         VehicleWeeklyCheckResult?
  strapsFasteners    VehicleWeeklyCheckResult?
  ballisticLayer     VehicleWeeklyCheckResult?
  cleanlinessStorage VehicleWeeklyCheckResult?
  overallReadiness   VehicleWeeklyCheckResult?

  remarks       String?    @db.Text
  inspectorName String?
  personnelId   String?
  personnel     Personnel? @relation(fields: [personnelId], references: [id], onDelete: SetNull)

  inspectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([assetId, monthYm])
  @@index([monthYm])
}

// --- Route master data ---

model RouteMaster {
  id            String   @id @default(uuid())
  name          String?
  startLocation String
  endLocation   String
  distanceKm    Decimal
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  missions Mission[]
}

// --- Missions ---

enum MissionStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MissionVehicleFuelType {
  GASOLINE
  DIESEL
}

model MissionPersonnelRoleMaster {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments MissionPersonnel[]
}

model MissionVehicleRoleMaster {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments MissionVehicle[]
}

model MissionExpenseTypeMaster {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses MissionExpense[]
}

model Mission {
  id           String        @id @default(uuid())
  code         String?       @unique
  title        String?
  status       MissionStatus @default(DRAFT)
  routeId      String?
  route        RouteMaster?  @relation(fields: [routeId], references: [id], onDelete: SetNull)
  budgetAmount Decimal?

  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  personnel    MissionPersonnel[]
  vehicles     MissionVehicle[]
  destinations MissionDestination[]
  expenses     MissionExpense[]
  attachments  MissionAttachment[]
}

/// ไฟล์แนบภารกิจ (อัปโหลดได้หลายไฟล์)
model MissionAttachment {
  id             String   @id @default(uuid())
  missionId      String
  mission        Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  /// ชื่อไฟล์บนดิสก์ (uuid + นามสกุล) ในโฟลเดอร์อัปโหลด
  storedFilename String
  originalName   String?
  mimeType       String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
}

model MissionPersonnel {
  id          String    @id @default(uuid())
  missionId   String
  mission     Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  personnelId String
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  personnelRoleId String
  personnelRole   MissionPersonnelRoleMaster @relation(fields: [personnelRoleId], references: [id], onDelete: Restrict)

  /// อัตราค่าตอบแทน (บาท) ต่อคนในภารกิจนี้ — ใช้รวมเข้าหมวดค่าตอบแทนในค่าใช้จ่าย
  compensationRate Decimal @default(0)

  @@unique([missionId, personnelId])
}

model MissionVehicle {
  id        String  @id @default(uuid())
  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  vehicleRoleId String
  vehicleRole   MissionVehicleRoleMaster @relation(fields: [vehicleRoleId], references: [id], onDelete: Restrict)

  /// การใช้น้ำมัน (ลิตร)
  fuelLiters Decimal?
  fuelType   MissionVehicleFuelType?

  @@unique([missionId, vehicleId])
}

model MissionDestination {
  id             String  @id @default(uuid())
  missionId      String
  mission        Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  sortOrder      Int     @default(0)
  address        String
  cargoValue     Decimal @default(0)
  containerCount Int     @default(0)
}

model MissionExpense {
  id        String  @id @default(uuid())
  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  expenseTypeId String
  expenseType   MissionExpenseTypeMaster @relation(fields: [expenseTypeId], references: [id], onDelete: Restrict)

  amount      Decimal
  description String?  @db.Text
  incurredAt  DateTime @default(now())
}

// --- งบประมาณ ---

enum BudgetFiscalYearStatus {
  ACTIVE
  CLOSED
}

enum BudgetAccountKind {
  EXPENSE
  CAPEX
}

enum BudgetSpendSource {
  IMPORT
  MANUAL
}

/// งบประจำปี vs งบผูกพัน (หลายปี)
enum BudgetFundingType {
  ANNUAL
  COMMITMENT
}

model BudgetFiscalYear {
  id        String                 @id @default(uuid())
  yearBe    Int                    @unique
  status    BudgetFiscalYearStatus @default(ACTIVE)
  notes     String?                @db.Text
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  lines BudgetYearLine[]
}

/// หมวดเอกสารประกอบงบ
model BudgetDocumentCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents BudgetDocument[]
}

/// เอกสารประกอบงบตาม bucket (ปี 2569 / 2570 / …)
model BudgetDocument {
  id           String                  @id @default(uuid())
  /// "2569" | "2570" | …
  bucketKey    String
  title        String
  notes        String?                 @db.Text
  categoryId   String?
  category     BudgetDocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  fileUrl      String
  mimeType     String?
  originalName String?
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([bucketKey])
  @@index([categoryId])
}

model BudgetCategory {
  id        String            @id @default(uuid())
  name      String
  kind      BudgetAccountKind @default(EXPENSE)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  accounts BudgetAccount[]

  @@index([kind])
}

model BudgetAccount {
  id         String            @id @default(uuid())
  parentId   String?
  parent     BudgetAccount?    @relation("BudgetAccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   BudgetAccount[]   @relation("BudgetAccountTree")
  categoryId String?
  category   BudgetCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ciCode     String?
  superiorCi String?
  fileRef    String?
  name       String
  definition String?           @db.Text
  kind       BudgetAccountKind @default(EXPENSE)
  sortOrder  Int               @default(0)
  isSummary  Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  yearLines    BudgetYearLine[]
  requests     BudgetRequest[]
  osAreaGroups OsAreaGroup[]

  @@index([ciCode])
  @@index([parentId])
  @@index([categoryId])
  @@index([kind])
}

model BudgetYearLine {
  id               String            @id @default(uuid())
  fiscalYearId     String
  fiscalYear       BudgetFiscalYear  @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  accountId        String
  account          BudgetAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// ANNUAL = งบประจำปีนั้น · COMMITMENT = งบผูกพันของปีอ้างอิง
  fundingType      BudgetFundingType @default(ANNUAL)
  allocatedAmount  Decimal           @default(0)
  carryInAmount    Decimal           @default(0)
  /// ยอดผูกพันสำรอง (ใช้เมื่อ fundingType=ANNUAL และมีคอลัมน์คู่ขนาน) — รายการ COMMITMENT ใส่ยอดใน allocatedAmount
  commitmentAmount Decimal           @default(0)
  buyerName        String?
  requestingUnit   String?
  quantity         String?
  /// ลิงก์เอกสารประกอบ (URL)
  documentUrl      String?           @db.Text
  notes            String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  snapshots    BudgetSpendSnapshot[]
  transactions BudgetTransaction[]

  @@unique([fiscalYearId, accountId, fundingType])
  @@index([fiscalYearId])
  @@index([fundingType])
}

model BudgetSpendSnapshot {
  id          String            @id @default(uuid())
  yearLineId  String
  yearLine    BudgetYearLine    @relation(fields: [yearLineId], references: [id], onDelete: Cascade)
  asOfDate    DateTime
  spentAmount Decimal           @default(0)
  source      BudgetSpendSource @default(MANUAL)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())

  @@index([yearLineId, asOfDate])
}

model BudgetTransaction {
  id          String         @id @default(uuid())
  yearLineId  String
  yearLine    BudgetYearLine @relation(fields: [yearLineId], references: [id], onDelete: Cascade)
  amount      Decimal
  occurredAt  DateTime       @default(now())
  description String?        @db.Text
  refNo       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  osMonthlyAcceptance OsMonthlyAcceptance?

  @@index([yearLineId, occurredAt])
}

model BudgetRequest {
  id              String        @id @default(uuid())
  accountId       String
  account         BudgetAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  targetYearBe    Int
  requestedAmount Decimal       @default(0)
  deltaAmount     Decimal?
  deltaPercent    Decimal?
  changeDirection String?
  reason          String?       @db.Text
  planEndAmount   Decimal?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([accountId, targetYearBe])
  @@index([targetYearBe])
}

// --- Auth & admin ---

enum UserRole {
  ADMIN
  OPERATOR
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(OPERATOR)
  fullName     String?
  /// รูปโปรไฟล์ — path เช่น /uploads/uuid.png
  avatarUrl    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

/// ประวัติการแก้ไขระบบ (audit trail)
model AuditLog {
  id            String      @id @default(uuid())
  entityType    String
  entityId      String
  action        AuditAction
  summary       String      @db.Text
  beforeJson    String?     @db.LongText
  afterJson     String?     @db.LongText
  actorUserId   String?
  actorUsername String?
  createdAt     DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// --- กิจกรรม (เดิม WorkTask / Notion — notionUrl เก็บย้อนหลังได้) ---

enum WorkTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model WorkTask {
  id          String          @id @default(uuid())
  title       String
  notionUrl   String?         @db.Text
  description String?         @db.Text
  startsAt    DateTime?
  endsAt      DateTime?
  location    String?
  recordedBy  String?
  status      WorkTaskStatus  @default(TODO)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  photos      WorkTaskPhoto[]
}

model WorkTaskPhoto {
  id           String   @id @default(uuid())
  workTaskId   String
  workTask     WorkTask @relation(fields: [workTaskId], references: [id], onDelete: Cascade)
  fileUrl      String
  mimeType     String
  originalName String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
}

// --- เหตุการณ์ไม่ปกติ (Security Incident Report) ---

model SecurityIncident {
  id                  String    @id @default(uuid())
  externalId          Int       @unique
  title               String    @db.Text
  location            String?
  incidentAt          DateTime?
  timeOfIncident      DateTime?
  incidentType        String?
  impactLevel         String?   @db.Text
  statusResolved      Boolean   @default(false)
  impactTypes         String?   @db.Text
  damageValue         String?   @db.Text
  cause               String?   @db.LongText
  details             String?   @db.LongText
  actionExecuted      String?   @db.LongText
  preventiveSolutions String?   @db.LongText
  commanderOrder      String?   @db.LongText
  linkBotShare        String?   @db.Text
  reportingOfficer    String?   @db.Text
  createdBy           String?
  sourceCreatedAt     DateTime?
  sourceModifiedBy    String?
  sourceModifiedAt    DateTime?
  attachmentsCount    Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([incidentAt])
  @@index([incidentType])
  @@index([location])
  @@index([statusResolved])
}

// --- สืบสวนและประมวลข่าว (Investigation & Intelligence) ---

enum InvestigationCategoryKind {
  STRATEGIC
  BAU
}

enum InvestigationCaseStatus {
  DRAFT
  PENDING_APPROVAL
  OPEN
  IN_PROGRESS
  PENDING_EXTERNAL
  REPORT_SUBMITTED
  CLOSED
  ARCHIVED
  REJECTED
}

/// ตำแหน่งตามสายงานสืบสวน — ใช้จัดลำดับการอนุมัติ
enum InvestigationOrgRole {
  DIRECTOR
  DEPUTY_DIRECTOR
  ASSISTANT_DIRECTOR
  INVESTIGATOR
}

enum InvestigationIssueStatus {
  OPEN
  IN_PROGRESS
  DONE
  DROPPED
}

enum InvestigationDocumentKind {
  EVIDENCE
  REPORT
  ATTACHMENT
}

enum InvestigationApprovalStage {
  CASE_OPEN
  FINAL_REPORT
}

enum InvestigationApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum MailOutboxStatus {
  QUEUED
  SENT
  FAILED
}

model InvestigationCategory {
  id          String  @id @default(uuid())
  /// ชื่อหลักภาษาไทย (แฟ้มคดี / หมวดย่อย)
  name        String
  /// ชื่อรองภาษาอังกฤษ — แสดงเป็น subtitle ใต้ชื่อไทย
  nameEn      String?
  /// รหัสแฟ้มหลัก เช่น FILE-1 (เฉพาะแฟ้มหลัก ไม่ใช้กับหมวดย่อย)
  code        String? @unique
  /// ขอบเขตของแฟ้ม (เก็บเอกสารประเภทใดบ้าง)
  description String? @db.Text

  kind   InvestigationCategoryKind @default(BAU)
  /// ทีมแนะนำเริ่มต้น (ไม่บังคับ) — คดีมอบหมายทีมใดก็ได้ทีละเคส
  teamId String?
  team   InvestigationTeam?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  /// null = แฟ้มหลัก · มีค่า = หมวดย่อยภายใต้แฟ้มนั้น
  parentId String?
  parent   InvestigationCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children InvestigationCategory[] @relation("CategoryTree")

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases    InvestigationCase[] @relation("CaseMainCategory")
  subCases InvestigationCase[] @relation("CaseSubCategory")

  @@index([parentId])
  @@index([teamId])
  @@index([parentId, sortOrder])
}

model InvestigationTeam {
  id           String   @id @default(uuid())
  name         String   @unique
  code         String?
  description  String?  @db.Text
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  /// หัวหน้าทีม — อ้าง InvestigationMember.id (ไม่ผูก FK เพื่อเลี่ยง cycle)
  leadMemberId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members    InvestigationMember[]
  cases      InvestigationCase[]
  categories InvestigationCategory[]
}

model InvestigationMember {
  id            String               @id @default(uuid())
  teamId        String?
  team          InvestigationTeam?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  /// บัญชีผู้ใช้ระบบ (ถ้ามี) — ใช้จับคู่กล่องงานรออนุมัติ
  userId        String?
  /// ทะเบียนกำลังพล (ถ้ามี)
  personnelId   String?
  fullName      String
  position      String?
  orgRole       InvestigationOrgRole @default(INVESTIGATOR)
  /// 1=จนท.สืบสวน 2=ผช.ผอ. 3=รอง ผอ. 4=ผอ. — ลำดับเสนอตามสายงาน
  approvalLevel Int                  @default(1)
  email         String?
  phone         String?
  active        Boolean              @default(true)
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  approvals      InvestigationApproval[]
  assignedIssues InvestigationIssue[]    @relation("IssueAssignee")
  ledCases       InvestigationCase[]     @relation("CaseLead")
  requestedCases InvestigationCase[]     @relation("CaseRequester")

  @@index([teamId, approvalLevel])
  @@index([userId])
}

model InvestigationCase {
  id                  String                  @id @default(uuid())
  caseNumber          String                  @unique
  title               String
  summary             String?                 @db.Text
  categoryId          String
  category            InvestigationCategory   @relation("CaseMainCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  /// หมวดย่อยภายใต้แฟ้มหลัก (ถ้ามี)
  subCategoryId       String?
  subCategory         InvestigationCategory?  @relation("CaseSubCategory", fields: [subCategoryId], references: [id], onDelete: SetNull)
  teamId              String?
  team                InvestigationTeam?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  leadMemberId        String?
  leadMember          InvestigationMember?    @relation("CaseLead", fields: [leadMemberId], references: [id], onDelete: SetNull)
  requestedByMemberId String?
  requestedByMember   InvestigationMember?    @relation("CaseRequester", fields: [requestedByMemberId], references: [id], onDelete: SetNull)
  status              InvestigationCaseStatus @default(DRAFT)
  priority            Int                     @default(2)
  slaDueAt            DateTime?
  openedAt            DateTime                @default(now())
  closedAt            DateTime?
  ownerUserId         String?
  tags                String?                 @db.Text

  /// ขั้นการอนุมัติที่กำลังดำเนินอยู่ (null = ไม่มีสายอนุมัติค้าง)
  approvalStage     InvestigationApprovalStage?
  conclusion        String?                     @db.Text
  recommendation    String?                     @db.Text
  reportSubmittedAt DateTime?
  approvedAt        DateTime?
  archivedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues    InvestigationIssue[]
  documents InvestigationDocument[]
  approvals InvestigationApproval[]
  events    InvestigationCaseEvent[]

  @@index([categoryId, status])
  @@index([teamId, status])
  @@index([slaDueAt])
  @@index([openedAt])
}

model InvestigationIssue {
  id               String                   @id @default(uuid())
  caseId           String
  case             InvestigationCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title            String
  detail           String?                  @db.Text
  status           InvestigationIssueStatus @default(OPEN)
  assigneeMemberId String?
  assignee         InvestigationMember?     @relation("IssueAssignee", fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  dueAt            DateTime?
  /// ผลการสืบสวนของประเด็นนี้
  finding          String?                  @db.Text
  sortOrder        Int                      @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  documents InvestigationDocument[]

  @@index([caseId, status])
}

model InvestigationDocument {
  id               String                    @id @default(uuid())
  caseId           String
  case             InvestigationCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  issueId          String?
  issue            InvestigationIssue?       @relation(fields: [issueId], references: [id], onDelete: SetNull)
  storedFilename   String
  originalName     String?
  mimeType         String?
  kind             InvestigationDocumentKind @default(ATTACHMENT)
  title            String?
  sortOrder        Int                       @default(0)
  uploadedByUserId String?
  createdAt        DateTime                  @default(now())

  @@index([caseId, sortOrder])
}

model InvestigationApproval {
  id               String                        @id @default(uuid())
  caseId           String
  case             InvestigationCase             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  stage            InvestigationApprovalStage
  /// ลำดับในสายงาน เริ่ม 1
  sequence         Int
  approverMemberId String?
  approver         InvestigationMember?          @relation(fields: [approverMemberId], references: [id], onDelete: SetNull)
  approverName     String?
  approverEmail    String?
  orgRole          InvestigationOrgRole
  decision         InvestigationApprovalDecision @default(PENDING)
  comment          String?                       @db.Text
  decidedAt        DateTime?
  decidedByUserId  String?
  /// sha256 ของ token ในลิงก์อีเมล — เก็บเฉพาะ hash
  tokenHash        String?                       @unique
  tokenExpiresAt   DateTime?
  notifiedAt       DateTime?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  @@index([caseId, stage, sequence])
  @@index([approverMemberId, decision])
}

model InvestigationCaseEvent {
  id          String            @id @default(uuid())
  caseId      String
  case        InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type        String
  message     String            @db.Text
  actorUserId String?
  actorName   String?
  createdAt   DateTime          @default(now())

  @@index([caseId, createdAt])
}

model MailOutbox {
  id          String           @id @default(uuid())
  to          String
  cc          String?
  subject     String
  body        String           @db.Text
  provider    String           @default("outbox")
  status      MailOutboxStatus @default(QUEUED)
  error       String?          @db.Text
  sentAt      DateTime?
  relatedType String?
  relatedId   String?
  createdAt   DateTime         @default(now())

  @@index([status, createdAt])
  @@index([relatedType, relatedId])
}

// --- งานจ้าง OS (outsourcing security) ---

model OsAreaGroup {
  id              String         @id @default(uuid())
  code            String         @unique
  name            String
  sortOrder       Int            @default(0)
  active          Boolean        @default(true)
  /// ลิงก์บัญชีย่อยงบประมาณ (กลุ่ม N ใต้ CI 5031116000)
  budgetAccountId String?
  budgetAccount   BudgetAccount? @relation(fields: [budgetAccountId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  contracts OsContract[]

  @@index([budgetAccountId])
  @@index([sortOrder])
}

model OsContract {
  id            String      @id @default(uuid())
  areaGroupId   String
  areaGroup     OsAreaGroup @relation(fields: [areaGroupId], references: [id], onDelete: Cascade)
  vendorName    String
  contractNo    String?
  title         String?
  startDate     DateTime
  endDate       DateTime
  monthlyAmount Decimal?
  notes         String?     @db.Text
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  acceptances OsMonthlyAcceptance[]
  documents   OsContractDocument[]

  @@index([areaGroupId, startDate, endDate])
  @@index([active])
}

model OsMonthlyAcceptance {
  id                  String             @id @default(uuid())
  contractId          String
  contract            OsContract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// YYYY-MM
  monthYm             String
  acceptedAmount      Decimal
  acceptedAt          DateTime           @default(now())
  remarks             String?            @db.Text
  budgetTransactionId String?            @unique
  budgetTransaction   BudgetTransaction? @relation(fields: [budgetTransactionId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  documents OsAcceptanceDocument[]

  @@unique([contractId, monthYm])
  @@index([monthYm])
}

/// เอกสารตรวจรับรายเดือน — ลิงก์ไปคลังเอกสารหมวด «งานจ้าง OS»
model OsAcceptanceDocument {
  id                String              @id @default(uuid())
  acceptanceId      String
  acceptance        OsMonthlyAcceptance @relation(fields: [acceptanceId], references: [id], onDelete: Cascade)
  libraryDocumentId String
  libraryDocument   LibraryDocument     @relation(fields: [libraryDocumentId], references: [id], onDelete: Cascade)
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())

  @@unique([acceptanceId, libraryDocumentId])
  @@index([libraryDocumentId])
}

/// เอกสารสัญญา — ลิงก์ไปคลังเอกสารหมวด «งานจ้าง OS»
model OsContractDocument {
  id                String          @id @default(uuid())
  contractId        String
  contract          OsContract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  libraryDocumentId String
  libraryDocument   LibraryDocument @relation(fields: [libraryDocumentId], references: [id], onDelete: Cascade)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())

  @@unique([contractId, libraryDocumentId])
  @@index([libraryDocumentId])
}
