# --- MySQL ในเครื่อง (พอร์ต 3306) ---
# แก้ USER / PASSWORD ให้ตรงกับ MySQL ที่ติดตั้งบนเครื่อง
# แล้วสร้าง DB: CREATE DATABASE cit_mission CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/cit_mission"

PORT=4000
# รับคำขอจากเครื่องอื่นใน LAN (ค่าเริ่มต้น 0.0.0.0)
HOST=0.0.0.0
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000

# JWT (ตั้งค่าให้ยาวและสุ่มใน production)
JWT_SECRET="change-me-in-production"

# สร้าง admin คนแรกอัตโนมัติเมื่อยังไม่มี user ในฐานข้อมูล
INITIAL_ADMIN_USERNAME=Rohman
INITIAL_ADMIN_PASSWORD="your-secure-password"
