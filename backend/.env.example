# Local (no PostgreSQL): SQLite
DATABASE_URL="file:./dev.db"

# Production: PostgreSQL
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cit_mission?schema=public"

PORT=4000
# รับคำขอจากเครื่องอื่นใน LAN (ค่าเริ่มต้น 0.0.0.0)
HOST=0.0.0.0
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000

# JWT (ตั้งค่าให้ยาวและสุ่มใน production)
JWT_SECRET="change-me-in-production"

# สร้าง admin คนแรกอัตโนมัติเมื่อยังไม่มี user ในฐานข้อมูล
INITIAL_ADMIN_USERNAME=Rohman
INITIAL_ADMIN_PASSWORD="your-secure-password"
